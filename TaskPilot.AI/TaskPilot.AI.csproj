<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Prompts\CV\ParseCvPrompt.txt" />
    <None Remove="Prompts\Requirements\Clarification.yaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Prompts\CV\ParseCvPrompt.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.76.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Google" Version="1.76.0-alpha" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.76.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Yaml" Version="1.76.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskPilot.DTOs\TaskPilot.DTOs.csproj" />
    <ProjectReference Include="..\TaskPilot.Models\TaskPilot.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Folder Include="Builders\" />
	<Folder Include="Constants\" />
	<Folder Include="Extensions\" />
	<Folder Include="RAG\" />
	<Folder Include="Plugins\" />
  </ItemGroup>
	<ItemGroup>
		<Content Include="Prompts/**/*.yaml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
	  <None Update="Prompts\Requirements\Ambiguity.yaml">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Prompts\Requirements\Builder.yaml">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Prompts\Requirements\Completeness.yaml">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Prompts\Requirements\Extraction.yaml">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Prompts\Requirements\inputProcessing.yaml">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
</Project>
